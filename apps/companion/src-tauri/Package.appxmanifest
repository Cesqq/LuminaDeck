<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest — Microsoft Store submission manifest for LuminaDeck
  Studio (the Tauri Windows companion). Consumed by `scripts/build-msix.ps1`
  which packages the Tauri-built binary into an MSIX for Partner Center
  upload.

  The `Publisher` CN and `Name` below must match the LuminaDeck publisher
  identity in Partner Center. If they don't, `makeappx pack` produces a
  package Partner Center rejects at upload with "Package identity
  mismatch". The values here mirror memory/tech_decisions.md:
    - Publisher CN: 24DA9F28-A632-4B32-AB31-FAD4EC93A0A2
    - Package Name: CZRE.LuminaDeck
  Update both if the Partner Center identity rotates.

  `runFullTrust` rescap is REQUIRED — without it the companion can't:
    * Open a listening TCP socket for the WebSocket + /intent-execute
    * Broadcast via mDNS / Bonjour
    * Use the Windows `SendInput` APIs for keybind actions
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="CZRE.LuminaDeck"
    Publisher="CN=24DA9F28-A632-4B32-AB31-FAD4EC93A0A2"
    Version="1.3.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Lumina Deck Studio</DisplayName>
    <PublisherDisplayName>CZRE</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Turn your phone into a custom macro deck for your Windows PC over local Wi-Fi. Zero cloud relay, TLS-encrypted pairing, open protocol.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="LuminaDeckStudio" Executable="luminadeck-companion.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Lumina Deck Studio"
        Description="Lumina Deck Studio companion"
        BackgroundColor="#0D0D0D"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="LuminaDeck">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0D0D0D" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust is RESCAP: required + pre-approved for Store submission
         on Win32 apps. No additional Microsoft approval needed despite the
         "restricted" namespace. -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
