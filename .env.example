# LuminaDeck Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# RevenueCat (required for IAP)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Supabase (optional — app works fully offline without these)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (optional override — App.tsx has an inline public DSN fallback).
# DSN is a public client key, safe to commit. Leave blank to use the default.
EXPO_PUBLIC_SENTRY_DSN=
